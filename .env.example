# ─── Supabase: ТОЛЬКО сервер ───────────────────────────────────────────────
# У таблиц проекта включён RLS и нет anon-политик, а вью campaign_stats создано
# с security_invoker=true. Поэтому читать можно только service-role ключом
# и только из app/api/*/route.ts. Префикса NEXT_PUBLIC_ здесь быть не должно:
# иначе ключ попадёт в клиентский бандл.
SUPABASE_URL=https://hbnuxcdrdtzotlxaskwp.supabase.co
SUPABASE_SERVICE_KEY=<service_role key из Supabase → Project Settings → API>

# ─── Telegram Mini App ─────────────────────────────────────────────────────
# Приложение само в Telegram Bot API не ходит: токен бота ему не нужен.
# ID владельца нужен, только если будете включать проверку initData.
ADMIN_TELEGRAM_ID=7694835964
